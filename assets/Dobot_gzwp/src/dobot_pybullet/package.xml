<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dobot_pybullet</name>
  <version>0.1.0</version>
  <description>High-Performance PyBullet Physics Simulator and Visualizer for Dobot Nova 5 on macOS</description>
  <maintainer email="monojitlayek@todo.todo">monojitlayek</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>dobot_description</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

